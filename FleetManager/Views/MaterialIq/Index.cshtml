@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#103a2b">
<meta name="robots" content="noindex">
<title>MaterialIQ — JCK Plant Intelligence</title>
<link rel="icon" type="image/jpeg" href="~/img/jck-logo.jpg">
<link rel="stylesheet" href="~/css/fleet.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/users.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/materialiq.css" asp-append-version="true">
</head>
<body class="mq-theme">
<div class="mq-shell">
  <aside class="mq-side">
    <div class="mq-brand">MaterialIQ<span>JCK · PLANT INTELLIGENCE</span></div>
    <nav class="mq-nav" id="mqNav"></nav>
    <div class="mq-side-foot">
      <strong>JCK BATCH PLANT</strong>
      <span>Inventory · Demand · Supply</span>
      <a href="/">← Back to FleetManager</a>
    </div>
  </aside>
  <main class="mq-main">
    <div class="mq-crumb">OPERATIONS / MATERIALS CONTROL</div>
    <div class="mq-head">
      <div><h1 id="mqTitle">Inventory overview</h1><p id="mqSub">Purchasing decisions connected to your production.</p></div>
      <button class="btn primary" id="mqRecord">+ Record purchase</button>
    </div>
    <div class="toolbar mq-filters">
      <div class="filters">
        <label>Plant <select id="fPlant"><option value="">All plants</option></select></label>
        <label>Cutoff / planning date <input id="fDate" type="date"></label>
        <button class="btn secondary" id="mqExport">↓ Export data</button>
        <small id="mqStatus" class="mq-status"></small>
      </div>
    </div>
    <div id="view"></div>
  </main>
</div>

<dialog id="mqDialog" class="modal">
  <form id="mqForm" method="dialog" novalidate>
    <div class="modal-body">
      <h3 id="mqDlgTitle"></h3>
      <div id="mqDlgFields" class="form-grid"></div>
      <div class="modal-error" id="mqDlgError" role="alert"></div>
      <div class="modal-actions">
        <button type="button" class="secondary" id="mqDlgCancel">Cancel</button>
        <button type="submit" class="primary" id="mqDlgSave">Save</button>
      </div>
    </div>
  </form>
</dialog>

<div id="toast" class="toast"></div>
<script src="~/js/materialiq.js" asp-append-version="true"></script>
</body>
</html>
