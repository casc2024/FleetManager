<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>FleetManager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <!-- JCK Sand Pit quoter (served behind auth by CotizadorController, not from wwwroot) -->
  <ItemGroup>
    <Content Include="Quoter\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="MaterialIQ\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
